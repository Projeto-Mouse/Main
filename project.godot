; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Projeto mouse"
run/main_scene="res://Menus/Menu Principal/MenuPrincipal.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[audio]

buses/default_bus_layout="res://Sons/Musicas/Menu/default_bus_layout.tres"

[autoload]

ControladorTraducao="*res://Auxiliares/ControladorTraducao.gd"
ControladorRuido="*res://Auxiliares/ControladorRuido.gd"
ControladorMusica="*res://Auxiliares/ControladorMusica.gd"
ControladorDebug="*res://Auxiliares/ControladorDebug.gd"

[debug]

settings/stdout/print_fps=true

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Projeto mouse"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[global_group]

Escalaveis="Objetos Escalaveis"
ItensInterativos="Grupo de itens interativos"
Entidades=""

